{
  "id": "qgis-mcp",
  "name": "QGIS Connector",
  "version": "0.12.0",
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "python",
  "entry": "qgis_mcp/server.py",
  "min_app_version": "0.4.0",
  "entitlement_tier": "pro",
  "port_env_var": "MCP_PORT",
  "token_env_var": "MCP_LICENSE_TOKEN",
  "stdio": true,
  "host_plugin": {
    "type": "qgis-plugin",
    "host_app": "QGIS",
    "install_target_template": "{base}/QGIS/profiles/default/python/plugins/qgis_mcp_plugin/",
    "artifact": "qgis_mcp_plugin.zip",
    "requires_host_restart": true,
    "socket_port_env_var": "QGIS_MCP_PORT",
    "supported_versions": [
      "3"
    ]
  },
  "platform_requirements": {
    "windows": [
      "Windows 10/11",
      "QGIS installed (plugin loaded in QGIS)"
    ],
    "qgis": [
      "QGIS plugin must be installed in the host profile; MCP server starts headless without it (tools fail with structured TOOL_ERROR)"
    ]
  },
  "config": {
    "env": [
      {
        "key": "QGIS_MCP_HOST",
        "label": "QGIS bridge host",
        "kind": "host",
        "secret": false,
        "required": false,
        "default": "127.0.0.1",
        "description": "Host running QGIS plugin bridge."
      },
      {
        "key": "QGIS_MCP_PORT",
        "label": "QGIS bridge port",
        "kind": "host",
        "secret": false,
        "required": false,
        "default": "9876",
        "description": "TCP port exposed by QGIS plugin bridge (default: 9876)."
      }
    ]
  },
  "package": {
    "include": [
      "qgis_mcp",
      "qgis_mcp_plugin",
      "qgis_mcp_plugin.zip",
      "API",
      "scripts/registry.json",
      "templates/templates.json"
    ],
    "exclude": []
  },
  "tool_tiers": {
    "core": [
      "add_features",
      "add_raster_layer",
      "add_vector_layer",
      "batch_commands",
      "create_layout",
      "delete_features",
      "evaluate_expression",
      "execute_code",
      "execute_processing",
      "execute_sql",
      "export_layout",
      "field_calculator",
      "get_algorithm_help",
      "get_error_hints",
      "get_field_statistics",
      "get_layer_features",
      "get_layers",
      "get_project_info",
      "list_processing_algorithms",
      "list_qgis_api_categories",
      "list_templates",
      "load_project",
      "load_template",
      "qgis_function_registry_query",
      "render_map",
      "save_project",
      "search_qgis_api",
      "select_features",
      "set_layer_labeling",
      "set_layer_style",
      "update_features"
    ],
    "relevance_floor": 5.5
  },
  "tool_index": {
    "exec_tool": "execute_code",
    "capabilities_file": "qgis_mcp/aiconnect-capabilities.json",
    "relevance_floor": 5.5
  }
}
