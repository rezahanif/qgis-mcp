{
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "id": "qgis-mcp",
  "name": "QGIS Connector",
  "version": "1.1.0",
  "description": "Automate QGIS Desktop GIS modeling, vector/raster spatial analysis, CRS transformations, and map rendering via MCP.",
  "publisher": "adapted by AiConnect",
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "python",
  "entry": "run_server.py",
  "entry_args": [],
  "stdio": true,
  "token_env_var": "MCP_LICENSE_TOKEN",
  "entitlement_tier": "pro",
  "platform_requirements": {
    "python": [
      "Python >= 3.10"
    ],
    "host": [
      "QGIS 3.28+ LTR or later (Windows desktop software)"
    ]
  },
  "package": {
    "include": [
      "run_server.py",
      "src",
      "src/qgis_mcp/aiconnect_aliases.json"
    ],
    "exclude": [],
    "vendor": [
      "_vendor"
    ]
  },
  "tool_tiers": {
    "core": [
      "qgis_get_capabilities",
      "qgis_health_check",
      "qgis_inspect_layer",
      "qgis_run_processing",
      "qgis_export_map_image",
      "qgis_get_active_project",
      "qgis_load_project",
      "qgis_zoom_to",
      "qgis_set_single_symbol",
      "qgis_get_algorithm_spec",
      "qgis_quick_map",
      "qgis_get_window_state",
      "qgis_get_ui_screenshot"
    ],
    "relevance_floor": 3.0,
    "aliases_file": "src/qgis_mcp/aiconnect_aliases.json"
  }
}